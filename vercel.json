{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build && node scripts/migrate.mjs --production-only",
  "ignoreCommand": "echo \"VERCEL_ENV=$VERCEL_ENV branch=$VERCEL_GIT_COMMIT_REF\"; [ \"$VERCEL_GIT_COMMIT_REF\" != \"main\" ]",
  "regions": ["cle1"]
}

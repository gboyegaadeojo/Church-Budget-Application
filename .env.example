# Names only. Real values live in Netlify and GitHub secrets (CLAUDE.md); copy to .env.local for development.

# Neon Postgres connection string (pooled). Used by the app and `npm run db:migrate`.
DATABASE_URL=

# Auth.js: a long random value, and the address the app runs at.
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# "Continue with Google" (Google Cloud OAuth client, Web application).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# "Continue with Planning Center" (Planning Center OAuth application).
PCO_CLIENT_ID=
PCO_CLIENT_SECRET=

# Group Leader check: Planning Center Personal Access Token (Application ID and Secret).
PCO_APP_ID=
PCO_PAT_SECRET=

# Scheduled jobs call /api/jobs/<name> with this bearer token (at least 16 characters).
JOBS_SECRET=

APP_TIMEZONE=America/Vancouver

# Optional, tests only: a Postgres server where integration tests may create and drop
# throwaway databases. Leave unset to run them in-process with PGlite.
TEST_DATABASE_URL=
